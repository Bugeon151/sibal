{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@suhaengcut/engine": ["../packages/engine/src/index.ts"],
      "@suhaengcut/engine-config": ["../packages/engine/src/config.ts"],
      "@suhaengcut/engine-fixtures": ["../packages/engine/test/fixtures.ts"]
    }
  },
  "include": ["src"]
}
